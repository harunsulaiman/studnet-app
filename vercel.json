{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm install --include=dev",
  "buildCommand": "npm run build:shared && npm run prisma:generate && npm run build:web",
  "outputDirectory": "apps/web/.next",
  "env": { "NEXT_SERVER_API": "true", "NODE_ENV": "production" }
}
