# Production
NODE_ENV=production
DATABASE_URL=postgresql://user:password@host:5432/studnet?schema=public
REDIS_URL=redis://host:6379
APP_ORIGIN=https://your-app.example.com
API_ORIGIN=https://your-app.example.com
# Leave SESSION_COOKIE_DOMAIN unset on Verc/Haiku so the cookie binds to the deployment host.
SESSION_COOKIE_SECURE=true
JWT_ACCESS_SECRET=replace_with_a_long_random_value_at_least_32_characters
JWT_REFRESH_SECRET=replace_with_a_second_independent_long_random_value
