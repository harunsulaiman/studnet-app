NODE_ENV=production
DATABASE_URL=postgresql://user:password@pooler-host:5432/studnet?schema=public
DATABASE_URL_UNPOOLED=postgresql://user:password@direct-host:5432/studnet?schema=public
REDIS_URL=rediss://default:password@upstash-host:6379
APP_ORIGIN=https://your-web-domain.example.com
API_ORIGIN=https://your-api-domain.example.com
NEXT_PUBLIC_API_ORIGIN=https://your-api-domain.example.com
CROSS_SITE_COOKIES=true
SESSION_COOKIE_SECURE=true
# Leave SESSION_COOKIE_DOMAIN unset so the cookie binds to the API deployment host.
JWT_ACCESS_SECRET=replace_with_a_long_random_value_at_least_32_characters
JWT_REFRESH_SECRET=replace_with_a_second_independent_long_random_value
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=studnet-media
R2_PUBLIC_URL=https://media.your-domain.example.com